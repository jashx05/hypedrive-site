{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.hypedrive-oauth.dynv6.net/status/schema/status.schema.json",
  "title": "HypeDrive public health status",
  "type": "object",
  "required": [
    "version",
    "user_id",
    "display_name",
    "overall",
    "checked_at",
    "services",
    "last_sync",
    "alerts"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "user_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "overall": { "$ref": "#/$defs/status" },
    "overall_message": { "type": "string", "maxLength": 250 },
    "checked_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "services": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/service" }
    },
    "last_sync": {
      "type": "object",
      "required": ["status", "at", "period", "movements"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success", "warning", "error", "unknown"]
        },
        "at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "period": { "type": ["string", "null"], "maxLength": 20 },
        "movements": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "message"],
        "properties": {
          "severity": { "$ref": "#/$defs/status" },
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$",
            "maxLength": 80
          },
          "message": { "type": "string", "maxLength": 300 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["green", "orange", "red"]
    },
    "service": {
      "type": "object",
      "required": ["status", "label", "message"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "label": { "type": "string", "maxLength": 80 },
        "message": { "type": "string", "maxLength": 250 },
        "detail": { "type": "string", "maxLength": 250 },
        "days_until_expiry": { "type": ["integer", "null"] },
        "consent_valid_until": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "last_success": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
